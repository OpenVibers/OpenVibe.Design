# OpenVibe.Design — environment (production: /etc/openvibe/design.env). Names only; never commit values.

NODE_ENV=production
PORT=5090
HOST=127.0.0.1
BASE_URL=https://openvibe.design
TRUST_PROXY=2

# OpenVibe.Network: the theme API this service proxies, sign-in (OAuth client `design`, PKCE S256) and its JWKS.
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_OAUTH_CLIENT_ID=design
OV_OAUTH_CLIENT_SECRET=
# The browser is sent to the public origin; the token exchange and the JWKS use the internal one above.
# OV_NETWORK_URL=https://openvibe.network
# OV_NETWORK_ISSUER=https://openvibe.network
# OV_OAUTH_REDIRECT_URI=https://openvibe.design/auth/callback
# OV_SESSION_AUDIENCE=openvibe.network

# Optional: the public catalogue's in-process cache (default 5 minutes), the Network timeout, the per-IP limit.
# DESIGN_THEME_CACHE_MS=300000
# DESIGN_UPSTREAM_TIMEOUT_MS=8000
# DESIGN_RATE_LIMIT_PER_MIN=120

# optional: defaults to true in production
# COOKIE_SECURE=true
