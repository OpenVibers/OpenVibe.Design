[Unit]
Description=OpenVibe.Design — Make it yours, find the best AI designer.
# Network (sign-in, JWKS, the theme API) should be up first, but OpenVibe.Design degrades honestly without it: the
# pages and the public catalogue serve, and sign-in waits for the signing key (see /api/ready).
After=network.target
Wants=openvibe-network.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.design
EnvironmentFile=/etc/openvibe/design.env
Environment=NODE_ENV=production
Environment=PORT=5090
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.design/server/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
# In-flight requests get the 10 s drain.
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Stateless: the code tree is read-only and nothing here writes to disk.

[Install]
WantedBy=multi-user.target
